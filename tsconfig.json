{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "public/state.js",
    "public/taskItem.js",
    "public/taskCard.js",
    "public/emptyState.js",
    "public/queueColumn.js",
    "public/statusBadge.js"
  ]
}
